# =====================================================================
# .env da stack (lido pelo docker compose para preencher ${...}).
# NÃO versionar no git. Gere segredos com: openssl rand -hex 32
# As variáveis da Evolution ficam em evolution.env (separado).
# =====================================================================

# --- Identidade da stack (na plataforma: 1 valor por cliente) --------
STACK_NAME=docker-n8n                     # mantém os nomes de volume atuais
SHARED_NETWORK=docker-n8n_private-bridge  # rede que Chatwoot/Asterisk usam
TZ=America/Sao_Paulo

# --- Domínios públicos -----------------------------------------------
N8N_HOST=performa-ia.duckdns.org
EVOLUTION_HOST=api-performa-ia.duckdns.org
TRAEFIK_HOST=traefik-performa-ia.duckdns.org
PORTAINER_HOST=portainer-performa-ia.duckdns.org
# Mac atrás do NAT 8443->443: ":8443". Na VPS: deixe vazio.
PUBLIC_PORT_SUFFIX=:8443

# --- TLS (Let's Encrypt por DNS) ---------------------------------------
EMAIL=thiago.bueno@performacloud.com.br
ACME_DNS_PROVIDER=duckdns
DUCKDNS_TOKEN=004e6f79-fe9e-4eb5-a589-2c830f26c95a
# htpasswd -nbB admin 'SENHA'  -> cole entre aspas SIMPLES, com $ simples
TRAEFIK_BASICAUTH='admin:$2y$05$Q5w1cbj.OX8pd/bOldHpzOUSMToJCwc73eMqs4zZQDSB0lWU1lkA.'

# --- Versões fixas (anote a que está rodando hoje antes de trocar) ----
N8N_IMAGE=n8nio/n8n:2.35.7
EVOLUTION_IMAGE=evoapicloud/evolution-api:latest
TRAEFIK_IMAGE=traefik:v3.0
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:alpine
PORTAINER_IMAGE=portainer/portainer-ce:lts
ASTERISK_IMAGE=performa/asterisk-discador:1.0

# --- Postgres (n8n e Evolution) --------------------------------------
POSTGRES_USER=thiago_bueno
POSTGRES_PASSWORD=Tgb6878        # só [0-9a-f]: vai dentro de uma URI
POSTGRES_DB=evolution

# --- Redis (agora com senha) -------------------------------------------
REDIS_PASSWORD=9763a2046ce5a8d3f3b1031764b20ce73d4fb041ca89bea5f7806c781389fe96

# --- n8n -----------------------------------------------------------------
# Copie a chave que já existe no volume (ver README, passo 1).
N8N_ENCRYPTION_KEY=PML63xghdEEm+S9mSoDYhvW7bB4EESnC

# --- Asterisk (discador) ---------------------------------------------
SIP_EXTERNAL_IP=TROCAR_ip_publico     # Mac: IP público/DuckDNS. VPS: IP da VPS
PBX_HOST=TROCAR_fqdn_do_3cx           # 3CX hospedado (não mais IP da LAN)
SIP_AUTH_ID=TROCAR
SIP_PASSWORD=TROCAR
ARI_PASSWORD=TROCAR_hex
